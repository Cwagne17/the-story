            "source": "openmaptiles",
            "source-layer": "landcover",
            "paint": {
                "fill-color": "#5f4a35",
                "fill-opacity": 0.7
            }
        },
        {
            "id": "water",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "water",
            "paint": {
                "fill-color": "#263f46"
            }
        },
        {
            "id": "waterway",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "waterway",
            "paint": {
                "line-color": "#345963",
                "line-width": 1.4,
                "line-opacity": 0.85
            }
        }
    ]
}